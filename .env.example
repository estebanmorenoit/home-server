# Copy this file to .env and fill in your values
# cp .env.example .env

# Paths
DOCKERDIR=/home/<user>/docker/home-server
MEDIALIBRARY=/path/to/media
DATAPOOL=/path/to/datapool

# Network
IPADDRESS=192.168.x.x

# Linuxserver permissions (run `id` to find your values)
PUID=1000
PGID=1000
TZ=Europe/London

# Plex claim token — get one at https://www.plex.tv/claim/ (valid for 4 minutes)
PLEXCLAIM=claim-xxxxxxxxxxxxxxxxxxxx

# User info (used by some services)
USER=yourusername
USEREMAIL=you@example.com
PW=
PW_DB=

# SSL (optional, for reverse proxy setups)
DOMAIN=yourdomain.com
EMAIL=you@yourdomain.com
